<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="main.java.com.magdezis.inversionesmagdezis.controller.auth.LoginController">
    <stylesheets>
        <URL value="@/main/resources/css/login-view.css" />
    </stylesheets>
    <children>
        <Pane prefHeight="400.0" prefWidth="604.0">
            <children>
                <Label layoutX="288.0" layoutY="65.0" text="Email" />
                <TextField fx:id="txtEmail" layoutX="227.0" layoutY="95.0" />

                <Label layoutX="272.0" layoutY="135.0" text="Contraseña" />
                <PasswordField fx:id="txtPassword" layoutX="227.0" layoutY="165.0" />

                <!-- Label para mostrar mensajes de error o éxito -->
                <Label fx:id="lblMensaje" alignment="CENTER" layoutX="152.0" layoutY="210.0" prefWidth="300.0" />

                <Button fx:id="btnLogin" layoutX="259.0" layoutY="250.0" mnemonicParsing="false" onAction="#handleLogin" text="Iniciar Sesión" />
            
                <Hyperlink layoutX="220.0" layoutY="300.0" onAction="#handleGoToRegister" text="¿No tienes cuenta? Registrate" />
            </children>
        </Pane>
    </children>
</AnchorPane>